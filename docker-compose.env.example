NODE_ENV=production
PORT=5011

DATABASE_URL=
DIRECT_URL=

R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

ASSET_RETENTION_DAYS=7
WORKER_HEARTBEAT_STALE_MS=15000
WORKER_LOOP_INTERVAL_MS=5000
WORKER_PROCESSING_TIMEOUT_MS=3600000
SUBTITLE_UPLOAD_MAX_BYTES=1073741824
SUBTITLE_AUDIO_MAX_BYTES=536870912
SUBTITLE_UPLOAD_TOKEN_SECRET=
# whisper.cpp 바이너리: models/download-ggml-model.sh로 받은 모델과 함께 git clone된 저장소에서 build-linux/bin/whisper-cli를 사용한다.
WHISPER_CLI_PATH=/whisper.cpp/build-linux/bin/whisper-cli
WHISPER_CPP_HOST_DIR=/Users/your-name/dev/tools/whisper.cpp
# ⚠️ WARNING: WHISPER_CPP_HOST_DIR의 models/ 디렉터리에 ggml-base.en.bin과 ggml-small.en.bin이 반드시 있어야 한다. git clone만으로는 부족하며, models/download-ggml-model.sh base.en과 models/download-ggml-model.sh small.en을 실행해 받아야 한다.
WHISPER_MODEL_BASE_EN_PATH=/whisper.cpp/models/ggml-base.en.bin
WHISPER_MODEL_SMALL_EN_PATH=/whisper.cpp/models/ggml-small.en.bin
WHISPER_THREADS=4
