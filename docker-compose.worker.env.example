WORKER_LOOP_INTERVAL_MS=5000
WORKER_PROCESSING_TIMEOUT_MS=3600000
SUBTITLE_AUDIO_MAX_BYTES=536870912

# whisper.cpp 저장소의 호스트 절대 경로. 컨테이너의 /whisper.cpp에 read-only로 연결된다.
WHISPER_CPP_HOST_DIR=/Users/your-name/dev/tools/whisper.cpp
WHISPER_CLI_PATH=/whisper.cpp/build-linux/bin/whisper-cli
# models/download-ggml-model.sh base.en 및 small.en으로 두 모델을 모두 받아야 한다.
WHISPER_MODEL_BASE_EN_PATH=/whisper.cpp/models/ggml-base.en.bin
WHISPER_MODEL_SMALL_EN_PATH=/whisper.cpp/models/ggml-small.en.bin
WHISPER_THREADS=4
